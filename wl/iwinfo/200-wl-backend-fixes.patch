+static int wl_get_htmode(const char *ifname, int *buf)
+{
+	int modes, bw = 20;
+	char cdata[64];
+
+	/* "chanspec" iovar: the name goes in, the value comes back in place */
+	memset(cdata, 0, sizeof(cdata));
+	strcpy(cdata, "chanspec");
+
+	if (!wl_ioctl(ifname, WLC_GET_VAR, cdata, sizeof(cdata)))
+	{
+		uint16_t cs = *(uint16_t *)cdata;
+
+		switch (cs & 0x3800)
+		{
+			case 0x1000: bw = 20;  break;
+			case 0x1800: bw = 40;  break;
+			case 0x2000: bw = 80;  break;
+			case 0x2800: bw = 160; break;
+		}
+	}
+
+	if (wl_get_hwmodelist(ifname, &modes))
+		return -1;
+
+	if (modes & IWINFO_80211_AC)
+		*buf = (bw >= 160) ? IWINFO_HTMODE_VHT160 :
+		       (bw >= 80)  ? IWINFO_HTMODE_VHT80  :
+		       (bw >= 40)  ? IWINFO_HTMODE_VHT40  : IWINFO_HTMODE_VHT20;
+	else if (modes & IWINFO_80211_N)
+		*buf = (bw >= 40) ? IWINFO_HTMODE_HT40 : IWINFO_HTMODE_HT20;
+	else
+		*buf = IWINFO_HTMODE_NOHT;
+
+	return 0;
+}
