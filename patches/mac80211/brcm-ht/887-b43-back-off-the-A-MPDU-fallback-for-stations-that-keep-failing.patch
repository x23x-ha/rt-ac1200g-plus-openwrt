From: OpenWrt RT-AC1200G+ port
Subject: [PATCH] b43: back off the A-MPDU fallback for stations that keep failing

885 stops A-MPDUs to a station for five minutes when too many of its
A-MPDU statuses come back without a block ack, then tries again. Some
stations (an Intel Windows laptop on a BCM43217: about half of its
A-MPDUs without a block ack) trip it again within seconds every time,
so they get a burst of retries and a stall every five minutes.

Double the off time with each fallback in a row, up to 40 minutes, and
start over at five minutes once a full window of 64 statuses passes
without a fallback.
--- a/drivers/net/wireless/broadcom/b43/b43.h
+++ b/drivers/net/wireless/broadcom/b43/b43.h
@@ -867,6 +867,8 @@
 	/* No TX block ack sessions until ampdu_off_until (jiffies) */
 	bool ampdu_off;
 	unsigned long ampdu_off_until;
+	/* Fallbacks in a row, without a clean window in between */
+	u8 ampdu_strikes;
 };
 
 /*
--- a/drivers/net/wireless/broadcom/b43/dma.c
+++ b/drivers/net/wireless/broadcom/b43/dma.c
@@ -1824,6 +1824,8 @@
 
 #define B43_AMPDU_HEALTH_WINDOW	64
 #define B43_AMPDU_OFF_TIME	(300 * HZ)
+/* The off time doubles with each fallback in a row, up to 8 times (40 min) */
+#define B43_AMPDU_MAX_BACKOFF	3
 
 /*
  * Some stations answer A-MPDUs with block acks that the firmware does not
@@ -1855,13 +1857,21 @@
 	if (b43_modparam_ampdu_noba_pct > 0 &&
 	    bsta->ampdu_no_ba * 100 >
 	    bsta->ampdu_statuses * b43_modparam_ampdu_noba_pct) {
-		b43info(dev->wl, "%pM: %u of %u A-MPDUs without block ack, sending without A-MPDUs for %u s\n",
+		unsigned long off = B43_AMPDU_OFF_TIME <<
+			min_t(u8, bsta->ampdu_strikes, B43_AMPDU_MAX_BACKOFF);
+
+		if (bsta->ampdu_strikes < U8_MAX)
+			bsta->ampdu_strikes++;
+		b43info(dev->wl, "%pM: %u of %u A-MPDUs without block ack, sending without A-MPDUs for %lu s\n",
 			sta->addr, bsta->ampdu_no_ba, bsta->ampdu_statuses,
-			B43_AMPDU_OFF_TIME / HZ);
-		bsta->ampdu_off_until = jiffies + B43_AMPDU_OFF_TIME;
+			off / HZ);
+		bsta->ampdu_off_until = jiffies + off;
 		bsta->ampdu_off = true;
 		for (tid = 0; tid < IEEE80211_NUM_TIDS; tid++)
 			ieee80211_stop_tx_ba_session(sta, tid);
+	} else {
+		/* a clean window: the next fallback starts at the short time again */
+		bsta->ampdu_strikes = 0;
 	}
 	bsta->ampdu_statuses = 0;
 	bsta->ampdu_no_ba = 0;
