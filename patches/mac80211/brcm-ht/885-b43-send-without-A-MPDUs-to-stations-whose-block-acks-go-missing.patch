From: OpenWrt RT-AC1200G+ port
Subject: [PATCH] b43: send without A-MPDUs to stations whose block acks go missing

On a BCM43217 (N-PHY rev 17) an Apple 2x2 client answers A-MPDUs with
block acks that arrive on time (median +1 us against the RTS/CTS
budget) and are well formed, yet the firmware reports about a third of
the A-MPDUs as not answered, with firmware 666.2 and 784.2 alike. Every
MPDU of those is sent again, and TCP to that client falls from 10-14
Mbit/s without A-MPDUs to under 5 Mbit/s with them, while an iPhone on
the same AP gets 35-40 Mbit/s with A-MPDUs and 1-2% of them unanswered.

Count the A-MPDU statuses without a block ack per station over windows
of 64, and when more than ampdu_noba_pct (35%) of them have none, stop
the TX block ack sessions of that station and refuse new ones for five
minutes, then try again.
diff --git a/drivers/net/wireless/broadcom/b43/b43.h b/drivers/net/wireless/broadcom/b43/b43.h
index 173405c..c205ef5 100644
--- a/drivers/net/wireless/broadcom/b43/b43.h
+++ b/drivers/net/wireless/broadcom/b43/b43.h
@@ -861,6 +861,12 @@ struct b43_sta {
 	struct sk_buff_head psq;
 	/* TIDs of psq reported to mac80211 as buffered */
 	u16 ps_tids;
+	/* A-MPDU statuses in the current window, and those without a block ack */
+	u16 ampdu_statuses;
+	u16 ampdu_no_ba;
+	/* No TX block ack sessions until ampdu_off_until (jiffies) */
+	bool ampdu_off;
+	unsigned long ampdu_off_until;
 };
 
 /*
diff --git a/drivers/net/wireless/broadcom/b43/dma.c b/drivers/net/wireless/broadcom/b43/dma.c
index 541aac7..60bb4a6 100644
--- a/drivers/net/wireless/broadcom/b43/dma.c
+++ b/drivers/net/wireless/broadcom/b43/dma.c
@@ -1822,6 +1822,51 @@ bool b43_dma_ampdu_busy(struct b43_wldev *dev, struct sk_buff *skb)
 	return ring->ampdu_inflight >= B43_AMPDU_INFLIGHT;
 }
 
+#define B43_AMPDU_HEALTH_WINDOW	64
+#define B43_AMPDU_OFF_TIME	(300 * HZ)
+
+/*
+ * Some stations answer A-MPDUs with block acks that the firmware does not
+ * take (seen with Apple 2x2 clients on a BCM43217: about a third of their
+ * timely, well-formed block acks reported as missing, with firmware 666.2
+ * and 784.2 alike). Every MPDU of such an A-MPDU is sent again, and TCP
+ * drops to a few Mbit/s. Count the A-MPDU statuses without a block ack per
+ * station and send to it without A-MPDUs for a while when there are too
+ * many.
+ */
+static void b43_dma_ampdu_health(struct b43_wldev *dev,
+				 struct ieee80211_sta *sta, bool ba)
+{
+	struct b43_sta *bsta = (struct b43_sta *)sta->drv_priv;
+	int tid;
+
+	if (bsta->ampdu_off) {
+		if (time_before(jiffies, bsta->ampdu_off_until))
+			return;
+		bsta->ampdu_off = false;
+		bsta->ampdu_statuses = 0;
+		bsta->ampdu_no_ba = 0;
+	}
+	bsta->ampdu_statuses++;
+	if (!ba)
+		bsta->ampdu_no_ba++;
+	if (bsta->ampdu_statuses < B43_AMPDU_HEALTH_WINDOW)
+		return;
+	if (b43_modparam_ampdu_noba_pct > 0 &&
+	    bsta->ampdu_no_ba * 100 >
+	    bsta->ampdu_statuses * b43_modparam_ampdu_noba_pct) {
+		b43info(dev->wl, "%pM: %u of %u A-MPDUs without block ack, sending without A-MPDUs for %u s\n",
+			sta->addr, bsta->ampdu_no_ba, bsta->ampdu_statuses,
+			B43_AMPDU_OFF_TIME / HZ);
+		bsta->ampdu_off_until = jiffies + B43_AMPDU_OFF_TIME;
+		bsta->ampdu_off = true;
+		for (tid = 0; tid < IEEE80211_NUM_TIDS; tid++)
+			ieee80211_stop_tx_ba_session(sta, tid);
+	}
+	bsta->ampdu_statuses = 0;
+	bsta->ampdu_no_ba = 0;
+}
+
 /*
  * Queue the MPDUs of an A-MPDU. The firmware sends frames marked first,
  * intermediate and last back to back as one PPDU, so the DMA engine is
@@ -1966,6 +2011,8 @@ static void b43_dma_handle_ampdu_txstatus(struct b43_wldev *dev,
 		b43_dma_ampdu_rate_status(dev, sta, &first, len, acked);
 		b43_dma_ampdu_airtime(dev, sta, &first, tid, bytes);
 	}
+	if (sta)
+		b43_dma_ampdu_health(dev, sta, status->ba_valid);
 	rcu_read_unlock();
 
 	if (skb_queue_empty(&retry))
diff --git a/drivers/net/wireless/broadcom/b43/main.c b/drivers/net/wireless/broadcom/b43/main.c
index 9af7e0a..46b8f6a 100644
--- a/drivers/net/wireless/broadcom/b43/main.c
+++ b/drivers/net/wireless/broadcom/b43/main.c
@@ -114,6 +114,10 @@ MODULE_PARM_DESC(btcoex, "Enable Bluetooth coexistence (default on)");
 int b43_modparam_verbose = B43_VERBOSITY_DEFAULT;
 module_param_named(verbose, b43_modparam_verbose, int, 0644);
 
+int b43_modparam_ampdu_noba_pct = 35;
+module_param_named(ampdu_noba_pct, b43_modparam_ampdu_noba_pct, int, 0644);
+MODULE_PARM_DESC(ampdu_noba_pct, "Stop A-MPDUs to a station for 5 min when more than this % of them get no block ack (0 = never)");
+
 static int modparam_ht_txchains;
 module_param_named(ht_txchains, modparam_ht_txchains, int, 0444);
 MODULE_PARM_DESC(ht_txchains, "HT TX chains to use: 0 = auto (one on N-PHY rev 7+), 1 = one stream without STBC, 2+ = all");
@@ -6207,6 +6211,9 @@ static int b43_op_ampdu_action(struct ieee80211_hw *hw,
 
 		if (!wl->ampdu_tx || !b43_ht_fw_loaded(wl))
 			return -EOPNOTSUPP;
+		/* Block acks from this station went missing, see dma.c */
+		if (bsta->ampdu_off && time_before(jiffies, bsta->ampdu_off_until))
+			return -EBUSY;
 		/*
 		 * The BK FIFO of the BCM4331 keeps the 10 blocks of the
 		 * initvals, too little for A-MPDUs. Like brcmsmac, send
diff --git a/drivers/net/wireless/broadcom/b43/main.h b/drivers/net/wireless/broadcom/b43/main.h
index 2189e5e..a90b9c9 100644
--- a/drivers/net/wireless/broadcom/b43/main.h
+++ b/drivers/net/wireless/broadcom/b43/main.h
@@ -27,6 +27,7 @@
 
 
 extern int b43_modparam_verbose;
+extern int b43_modparam_ampdu_noba_pct;
 
 /* Logmessage verbosity levels. Update the b43_modparam_verbose helptext, if
  * you add or remove levels. */
