From: OpenWrt RT-AC1200G+ port
Subject: [PATCH] b43: TEST: TX core override and power loop log

Test-only knobs: txcore=1/2/3 forces the PHY TX core mask of all frames,
nphy_pctl_log=1 logs the TX power control loop per core every 15 s,
ampdu_tx=0 never starts TX block ack sessions.
diff --git a/drivers/net/wireless/broadcom/b43/dma.c b/drivers/net/wireless/broadcom/b43/dma.c
index 60bb4a6..6d7369c 100644
--- a/drivers/net/wireless/broadcom/b43/dma.c
+++ b/drivers/net/wireless/broadcom/b43/dma.c
@@ -1694,6 +1694,14 @@ static bool b43_dma_complete_ampdu_frame(struct b43_wldev *dev,
 	struct b43_sta *bsta;
 	int i;
 
+	if (b43_modparam_ampdu_log > 0) {
+		b43_modparam_ampdu_log--;
+		pr_info("b43: ampdu seq %u cookie %04x ba %d ssn %u bmp %016llx -> %s\n",
+			b43_dma_ampdu_seq(skb), status->cookie, status->ba_valid,
+			status->ba_ssn, (unsigned long long)status->ba_bitmap,
+			acked ? "acked" : "MISS");
+	}
+
 	unmap_descbuffer(ring, meta->dmaaddr, skb->len, 1);
 	kfree(priv_info->bouncebuffer);
 	priv_info->bouncebuffer = NULL;
diff --git a/drivers/net/wireless/broadcom/b43/main.c b/drivers/net/wireless/broadcom/b43/main.c
index 46b8f6a..c9d5fe9 100644
--- a/drivers/net/wireless/broadcom/b43/main.c
+++ b/drivers/net/wireless/broadcom/b43/main.c
@@ -120,6 +120,25 @@ MODULE_PARM_DESC(ampdu_noba_pct, "Stop A-MPDUs to a station for 5 min when more
 
 static int modparam_ht_txchains;
 module_param_named(ht_txchains, modparam_ht_txchains, int, 0444);
+static bool modparam_ampdu_rts = true;
+module_param_named(ampdu_rts, modparam_ampdu_rts, bool, 0644);
+MODULE_PARM_DESC(ampdu_rts, "TEST: protect A-MPDUs of more than one MPDU with RTS/CTS");
+
+static bool modparam_ampdu_tx = true;
+module_param_named(ampdu_tx, modparam_ampdu_tx, bool, 0444);
+MODULE_PARM_DESC(ampdu_tx, "TEST: send A-MPDUs (0 = never start TX block ack sessions)");
+
+int b43_modparam_ampdu_log;
+static int b43_modparam_ampdu_polls = 10;
+module_param_named(ampdu_polls, b43_modparam_ampdu_polls, int, 0644);
+MODULE_PARM_DESC(ampdu_polls, "TEST: 1 us polls to wait for the block ack status package (10)");
+module_param_named(ampdu_log, b43_modparam_ampdu_log, int, 0644);
+MODULE_PARM_DESC(ampdu_log, "TEST: log the block ack verdict of the next N A-MPDU subframes");
+
+int b43_modparam_txcore;
+module_param_named(txcore, b43_modparam_txcore, int, 0644);
+MODULE_PARM_DESC(txcore, "TEST: force PHY TX core mask for all frames (1 = core 0, 2 = core 1, 3 = both)");
+
 MODULE_PARM_DESC(ht_txchains, "HT TX chains to use: 0 = auto (one on N-PHY rev 7+), 1 = one stream without STBC, 2+ = all");
 
 static int modparam_ht_stbc = -1;
@@ -1446,12 +1465,15 @@ static bool b43_read_ampdu_txstatus(struct b43_wldev *dev, u16 status,
 	u32 s1, s2;
 	int i;
 
-	for (i = 0; i < 10; i++) {
+	for (i = 0; i < b43_modparam_ampdu_polls; i++) {
 		s1 = b43_read32(dev, B43_MMIO_XMITSTAT_0);
 		if (s1 & 0x00000001)
 			break;
 		udelay(1);
 	}
+	if (b43_modparam_ampdu_log > 0)
+		pr_info("b43: ampdu status 2nd package %s after %d polls\n",
+			(s1 & 0x00000001) ? "ok" : "MISSING", i);
 	if (!(s1 & 0x00000001)) {
 		b43dbg(dev->wl, "A-MPDU block ack status missing\n");
 		return false;
@@ -1501,6 +1523,10 @@ static void handle_irq_transmit_status(struct b43_wldev *dev)
 		 * of the block ack bitmap instead of the frame count, and a
 		 * second package with the rest of the bitmap follows.
 		 */
+		if (b43_ampdu_tx_enabled(dev) && stat.for_ampdu &&
+		    b43_modparam_ampdu_log > 0)
+			pr_info("b43: ampdu status cookie %04x acked %d intermediate %d\n",
+				stat.cookie, stat.acked, stat.intermediate);
 		if (b43_ampdu_tx_enabled(dev) && stat.intermediate &&
 		    stat.for_ampdu) {
 			if (stat.acked)
@@ -1800,6 +1826,7 @@ static void b43_write_beacon_template(struct b43_wldev *dev,
 	ctl &= ~B43_TXH_PHY_ANT;
 	ctl &= ~B43_TXH_PHY_ENC;
 	ctl |= antenna;
+	ctl = b43_txcore_override(ctl);
 	if (b43_is_cck_rate(rate))
 		ctl |= B43_TXH_PHY_ENC_CCK;
 	else
@@ -3431,6 +3458,7 @@ static void b43_set_phytxctl_defaults(struct b43_wldev *dev)
 	ctl |= B43_TXH_PHY_ENC_CCK;
 	ctl |= B43_TXH_PHY_ANT01AUTO;
 	ctl |= B43_TXH_PHY_TXPWR;
+	ctl = b43_txcore_override(ctl);
 
 	b43_shm_write16(dev, B43_SHM_SHARED, B43_SHM_SH_BEACPHYCTL, ctl);
 	b43_shm_write16(dev, B43_SHM_SHARED, B43_SHM_SH_ACKCTSPHYCTL, ctl);
@@ -3443,7 +3471,7 @@ static void b43_mgmtframe_txantenna(struct b43_wldev *dev, int antenna)
 	u16 ant;
 	u16 tmp;
 
-	ant = b43_antenna_to_phyctl(antenna);
+	ant = b43_txcore_override(b43_antenna_to_phyctl(antenna));
 
 	/* For ACK/CTS */
 	tmp = b43_shm_read16(dev, B43_SHM_SHARED, B43_SHM_SH_ACKCTSPHYCTL);
@@ -3993,7 +4021,7 @@ static int b43_tx_ampdu(struct b43_wldev *dev, struct sk_buff_head *queue,
 	 * without RTS/CTS about one in six went unanswered with a single
 	 * station sending TCP acks. Protect A-MPDUs of more than one MPDU.
 	 */
-	if (n > 1)
+	if (n > 1 && modparam_ampdu_rts)
 		info->control.rates[0].flags |= IEEE80211_TX_RC_USE_RTS_CTS;
 	err = b43_dma_tx_ampdu(dev, skbs, n, len);
 	if (err == -ENOSPC) {
@@ -6454,7 +6482,7 @@ static int b43_setup_bands(struct b43_wldev *dev,
 		     phy->radio_rev == 9;
 
 	ht = b43_ht_supported(dev);
-	dev->wl->ampdu_tx = ht;
+	dev->wl->ampdu_tx = ht && modparam_ampdu_tx;
 
 	if (have_2ghz_phy && ht) {
 		dev->wl->band_2ghz_ht = limited_2g ? b43_band_2ghz_limited_ht :
diff --git a/drivers/net/wireless/broadcom/b43/main.h b/drivers/net/wireless/broadcom/b43/main.h
index a90b9c9..4d16a91 100644
--- a/drivers/net/wireless/broadcom/b43/main.h
+++ b/drivers/net/wireless/broadcom/b43/main.h
@@ -28,6 +28,8 @@
 
 extern int b43_modparam_verbose;
 extern int b43_modparam_ampdu_noba_pct;
+extern int b43_modparam_txcore;
+extern int b43_modparam_ampdu_log;
 
 /* Logmessage verbosity levels. Update the b43_modparam_verbose helptext, if
  * you add or remove levels. */
diff --git a/drivers/net/wireless/broadcom/b43/phy_n.c b/drivers/net/wireless/broadcom/b43/phy_n.c
index a4495db..b699208 100644
--- a/drivers/net/wireless/broadcom/b43/phy_n.c
+++ b/drivers/net/wireless/broadcom/b43/phy_n.c
@@ -6864,6 +6864,27 @@ static unsigned int b43_nphy_op_get_default_chan(struct b43_wldev *dev)
 	return 36;
 }
 
+/* TEST: log the TX power control loop state per core every 15 s */
+static bool nphy_pctl_log;
+module_param(nphy_pctl_log, bool, 0644);
+MODULE_PARM_DESC(nphy_pctl_log, "TEST: log the N-PHY TX power control state every 15 s");
+
+static void b43_nphy_op_pwork_15sec(struct b43_wldev *dev)
+{
+	u16 s1, s2;
+
+	if (!nphy_pctl_log)
+		return;
+	s1 = b43_phy_read(dev, B43_NPHY_C1_TXPCTL_STAT);
+	s2 = b43_phy_read(dev, B43_NPHY_C2_TXPCTL_STAT);
+	b43info(dev->wl, "pctl cmd 0x%04x idx %u/%u est %u/%u tpwr 0x%04x txcore %d\n",
+		b43_phy_read(dev, B43_NPHY_TXPCTL_CMD),
+		(s1 & B43_NPHY_TXPCTL_STAT_BIDX) >> B43_NPHY_TXPCTL_STAT_BIDX_SHIFT,
+		(s2 & B43_NPHY_TXPCTL_STAT_BIDX) >> B43_NPHY_TXPCTL_STAT_BIDX_SHIFT,
+		s1 & 0xff, s2 & 0xff,
+		b43_phy_read(dev, B43_NPHY_TXPCTL_TPWR), b43_modparam_txcore);
+}
+
 const struct b43_phy_operations b43_phyops_n = {
 	.allocate		= b43_nphy_op_allocate,
 	.free			= b43_nphy_op_free,
@@ -6877,4 +6898,5 @@ const struct b43_phy_operations b43_phyops_n = {
 	.switch_channel		= b43_nphy_op_switch_channel,
 	.get_default_chan	= b43_nphy_op_get_default_chan,
 	.recalc_txpower		= b43_nphy_op_recalc_txpower,
+	.pwork_15sec		= b43_nphy_op_pwork_15sec,
 };
diff --git a/drivers/net/wireless/broadcom/b43/xmit.c b/drivers/net/wireless/broadcom/b43/xmit.c
index 0fbe141..bcbcddc 100644
--- a/drivers/net/wireless/broadcom/b43/xmit.c
+++ b/drivers/net/wireless/broadcom/b43/xmit.c
@@ -845,6 +845,7 @@ int b43_generate_txhdr(struct b43_wldev *dev,
 	default:
 		B43_WARN_ON(1);
 	}
+	phy_ctl = b43_txcore_override(phy_ctl);
 
 	/* MAC control */
 	if (!(info->flags & IEEE80211_TX_CTL_NO_ACK))
diff --git a/drivers/net/wireless/broadcom/b43/xmit.h b/drivers/net/wireless/broadcom/b43/xmit.h
index 5e96816..3cda224 100644
--- a/drivers/net/wireless/broadcom/b43/xmit.h
+++ b/drivers/net/wireless/broadcom/b43/xmit.h
@@ -424,4 +424,12 @@ b43_get_priv_tx_info(struct ieee80211_tx_info *info)
 	return (struct b43_private_tx_info *)info->rate_driver_data;
 }
 
+/* TEST: force the PHY TX core mask (N-PHY rev 3+: bit 6 = core 0, bit 7 = core 1) */
+static inline u16 b43_txcore_override(u16 ctl)
+{
+	if (b43_modparam_txcore > 0 && b43_modparam_txcore < 4)
+		ctl = (ctl & ~B43_TXH_PHY_ANT) | (b43_modparam_txcore << 6);
+	return ctl;
+}
+
 #endif /* B43_XMIT_H_ */
