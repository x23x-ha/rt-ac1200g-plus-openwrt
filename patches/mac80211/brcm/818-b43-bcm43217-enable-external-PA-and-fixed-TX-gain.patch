From: OpenWrt RT-AC1200G+ port
Subject: [PATCH] b43: BCM43217: enable external PA/LNA control, fixed TX gain on EPA boards

The vendor wl driver (wlc_phy_init_nphy) sets PMU chipcontrol 1 bit 0x2000
on BCM43217 boards with an external LNA and bits 0x2100 when the external
PA uses digital control (BFL2_ANAPACTRL_* clear). Without that the external
2.4 GHz PA of EPA boards (ASUS RT-AC1200G+) never turns on.

The external power detector (TSSI) path is still not set up, so HW TX power
control reads a flat TSSI and pins the maximum gain index, overdriving the PA.
On BCM43217 EPA boards disable it and use a fixed index (default 40, just
below PA compression on the RT-AC1200G+; module param nphy_txidx).

--- a/drivers/net/wireless/broadcom/b43/phy_n.c
+++ b/drivers/net/wireless/broadcom/b43/phy_n.c
@@ -21,6 +21,20 @@
 #include "radio_2055.h"
 #include "radio_2056.h"
 #include "radio_2057.h"
+#include <linux/moduleparam.h>
+
+/* BCM43217 boards with an external 2.4 GHz PA: the TSSI path for the external
+ * power detector is not set up, so HW TX power control would pin max gain.
+ * Use a fixed gain index instead (0 = max, ~0.5 dB per step). */
+static int nphy_txidx = -1;
+module_param(nphy_txidx, int, 0444);
+MODULE_PARM_DESC(nphy_txidx, "N-PHY rev7+ fixed TX gain index 0..127 (BCM43217 EPA default 40)");
+
+static bool b43_nphy_bcm43217_epa(struct b43_wldev *dev)
+{
+	return dev->dev->chip_id == BCMA_CHIP_ID_BCM43217 &&
+	       dev->dev->bus_sprom->fem.ghz2.extpa_gain != 2;
+}
 #include "main.h"
 #include "ppr.h"
 
@@ -3748,6 +3762,10 @@
 	/* TODO: rev19+ */
 	if (dev->phy.rev >= 7) {
 		txpi[0] = txpi[1] = 30;
+		if (b43_nphy_bcm43217_epa(dev))
+			txpi[0] = txpi[1] = 40;
+		if (nphy_txidx >= 0 && nphy_txidx < 128)
+			txpi[0] = txpi[1] = nphy_txidx;
 	} else if (dev->phy.rev >= 3) {
 		txpi[0] = 40;
 		txpi[1] = 40;
@@ -5973,6 +5991,32 @@
 }
 
 /* http://bcm-v4.sipsolutions.net/802.11/PHY/Init/N */
+#ifdef CPTCFG_B43_BCMA
+/* BCM43217: the vendor driver (wlc_phy_init_nphy) routes the external LNA /
+ * digital PA control lines through PMU chipcontrol 1. Without this the
+ * external PA of EPA boards is never enabled. */
+static void b43_nphy_bcm43217_fem_ctl(struct b43_wldev *dev)
+{
+	struct ssb_sprom *sprom = dev->dev->bus_sprom;
+	struct bcma_drv_cc *cc;
+	bool ghz2 = b43_current_band(dev->wl) == NL80211_BAND_2GHZ;
+
+	if (dev->dev->bus_type != B43_BUS_BCMA ||
+	    dev->dev->chip_id != BCMA_CHIP_ID_BCM43217)
+		return;
+	cc = &dev->dev->bdev->bus->drv_cc;
+	if (!cc->pmu.core)
+		return;
+
+	if (sprom->boardflags_lo & B43_BFL_EXTLNA)
+		bcma_chipco_chipctl_maskset(cc, 1, ~0x2000, 0x2000);
+	/* external PA, digital control: BFL2_ANAPACTRL_2G/5G clear */
+	if (!b43_nphy_ipa(dev) &&
+	    !(sprom->boardflags2_hi & (ghz2 ? 0x0010 : 0x0020)))
+		bcma_chipco_chipctl_maskset(cc, 1, ~0x2100, 0x2100);
+}
+#endif
+
 static int b43_phy_initn(struct b43_wldev *dev)
 {
 	struct ssb_sprom *sprom = dev->dev->bus_sprom;
@@ -6004,6 +6048,9 @@
 #endif
 		}
 	}
+#ifdef CPTCFG_B43_BCMA
+	b43_nphy_bcm43217_fem_ctl(dev);
+#endif
 	nphy->use_int_tx_iq_lo_cal = b43_nphy_ipa(dev) ||
 		phy->rev >= 7 ||
 		(phy->rev >= 5 &&
@@ -6477,6 +6524,9 @@
 		nphy->ipa2g_on = sprom->fem.ghz2.extpa_gain == 2;
 		nphy->ipa5g_on = sprom->fem.ghz5.extpa_gain == 2;
 	}
+
+	if (b43_nphy_bcm43217_epa(dev))
+		nphy->txpwrctrl = false;
 }
 
 static void b43_nphy_op_free(struct b43_wldev *dev)
